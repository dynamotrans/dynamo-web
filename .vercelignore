# Archivos que se versionan en git pero NO se publican en la web.
# Sin esto, cualquiera podría descargarlos desde dynamotrans.com/<ruta>.

# Notas internas del proyecto (bitácora, pendientes, reglas de negocio, precios…)
*.md

# Generador de las hojas de sección (se ejecuta en local, no en el servidor)
tools/

# Plantillas de email de Brevo (las IMÁGENES de images/email/ sí se publican:
# el email las carga desde dynamotrans.com)
emails/

# Automatizaciones de GitHub
.github/

# Migraciones de la base de datos: no hacen falta para compilar la web.
# (OJO: scripts/ NO va aqui: lo necesita la compilacion de Next.js en pruebas.)
supabase/
