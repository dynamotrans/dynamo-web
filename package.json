{
  "name": "dynamo-plataforma",
  "private": true,
  "description": "Plataforma de Dynamo (Next.js) + web publica estatica. Solo en la rama pruebas.",
  "scripts": {
    "copiar-estaticos": "node scripts/copiar-estaticos.mjs",
    "dev": "node scripts/copiar-estaticos.mjs && next dev",
    "build": "node scripts/copiar-estaticos.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=1",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\""
  },
  "dependencies": {
    "@sentry/nextjs": "10.78.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "15.5.28",
    "pdf-lib": "1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
